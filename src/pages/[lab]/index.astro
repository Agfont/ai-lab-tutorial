---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LAB_OVERVIEWS, LAB_TASK_SUMMARIES } from "../../data/labs";
import { labs, type Lab } from "../../data/snapshot";
import { url } from "../../utils/url";

export function getStaticPaths() {
  return labs.map((labData) => ({ params: { lab: labData.slug }, props: { labData } }));
}

const { lab } = Astro.params;
const { labData } = Astro.props as { labData: Lab };

const currentLabInfo = LAB_OVERVIEWS[lab] || {
  about: "This lab contains guided tasks for one stage of the learning path.",
  concepts: ["Progressive hands-on learning"]
};

const currentTaskSummaries = LAB_TASK_SUMMARIES[lab] || [
  "Task sequence details are not available for this lab."
];
---

<BaseLayout
  title={`Lab: ${lab}`}
  subtitle="This page maps directly to a lab directory. Each task shows its source, completion marker, and recorded run output."
>
  <section class="card">
    <div style="display:flex; align-items:center; justify-content:space-between;">
      <h2 style="margin:0.5rem 0;">Tasks</h2>
      <a class="link-button secondary" href={url()}>Back to labs</a>
    </div>
    <div class="chips" style="margin-bottom:.8rem;">
      <span class="chip mono">{lab}</span>
      <span class="chip">Directory-backed route</span>
    </div>
    <article class="card" style="margin-bottom:.9rem;">
      <h3 style="margin-top:0;">Lab Overview</h3>
      <p class="muted" style="margin-top:.2rem;">{currentLabInfo.about}</p>
      <div class="chips">
        {currentLabInfo.concepts.map((concept) => (
          <span class="chip">{concept}</span>
        ))}
      </div>
      <h4 style="margin:.8rem 0 .3rem;">Per-Task Concept Summary</h4>
      <ul style="margin:.5rem 0 0;">
        {currentTaskSummaries.map((summary) => (
          <li>{summary}</li>
        ))}
      </ul>
    </article>
    <div id="task-grid" class="grid">
      {labData.tasks.length === 0 && <p class="muted">No task files discovered in this lab.</p>}
      {labData.tasks.map((task) => (
        <article class="card">
          <div class="chips">
            <span class="chip mono">{task.filename}</span>
            <span class={`chip ${task.marker_complete ? "ok" : ""}`}>{task.marker_complete ? "Complete" : "Not complete"}</span>
          </div>
          <h3 style="margin:.6rem 0;">Task {task.id}: {task.title}</h3>
          <a class="link-button" href={url(`${lab}/tasks/${task.id}/`)}>Open Task</a>
          <details style="margin-top:.7rem;">
            <summary>Show recorded output</summary>
            <pre class="mono">{task.output ?? "No recorded output for this task."}</pre>
          </details>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
