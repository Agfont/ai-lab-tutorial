---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { labs, type Task } from "../../../data/snapshot";

export function getStaticPaths() {
  return labs.flatMap((lab) =>
    lab.tasks.map((taskData) => ({ params: { lab: lab.slug, task: String(taskData.id) }, props: { taskData } }))
  );
}

const { lab, task } = Astro.params;
const { taskData } = Astro.props as { taskData: Task };
---

<BaseLayout
  title={`Task ${task} in ${lab}`}
  subtitle="Task view shows the source file, its completion marker, and the output recorded from a real run."
>
  <section class="card grid">
    <p style="margin:0; display:flex; gap:.55rem; flex-wrap:wrap;">
      <a class="link-button secondary" href={`/${lab}/`}>Back to lab</a>
    </p>

    <div class="chips">
      <span class="chip mono">{lab}</span>
      <span class="chip mono">task-{task}</span>
      <span class={`chip ${taskData.marker_complete ? "ok" : ""}`}>{taskData.marker_complete ? "Complete" : "Not complete"}</span>
    </div>

    <article class="card">
      <h2 style="margin-top:0;">Task source</h2>
      <p class="muted">{taskData.filename}</p>
      <pre class="mono">{taskData.source || "No source available."}</pre>
    </article>

    <article class="card">
      <h2 style="margin-top:0;">Recorded output</h2>
      <p class="muted">Captured from a previous run of this task; it is not executed live.</p>
      <pre class="mono">{taskData.output ?? "No recorded output for this task."}</pre>
    </article>
  </section>
</BaseLayout>
