---
import BaseLayout from "../layouts/BaseLayout.astro";
import { labs } from "../data/snapshot";
---

<BaseLayout
  title="AI Fundamentals Tutorial"
  subtitle="Each lab folder becomes a page. Every task shows its source code and the output recorded from a real run."
>
  <section class="card">
    <div class="grid" id="labs-grid">
      {labs.length === 0 && <p class="muted">No labs discovered.</p>}
      {labs.map((lab) => (
        <article class="card">
          <div class="chips">
            <span class="chip mono">{lab.directory}</span>
            <span class="chip">{lab.tasks.length} tasks</span>
          </div>
          <h2 style="margin: .65rem 0 .45rem;">{lab.title}</h2>
          <a class="link-button" href={`/${lab.slug}/`}>Open Lab</a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
